# Créer localement .env et ne jamais le pousser sur GitHub.
# Valeurs uniques pour cette instance de test.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHOISIR_UN_SECRET_FORT_DE_PLUS_DE_14_CARACTERES
DASHBOARD_SESSION_SECRET=GENERER_UNE_CLE_AVEC_OPENSSL_RAND_HEX_32
COOKIE_SECURE=0
# Facultatif : hôte LAN/mDNS des liens créés par défaut (valeur réelle uniquement dans .env local).
NAS_BROWSER_HOST=nas.local
# Ces valeurs sont facultatives : les API sont configurables depuis /settings?tab=integrations.
# JELLYFIN_URL=http://jellyfin:8096
# JELLYFIN_API_KEY=
# RADARR_URL=http://radarr:7878
# RADARR_API_KEY=
# SONARR_URL=http://sonarr:8989
# SONARR_API_KEY=
# SEERR_URL=http://seerr:5055
# SEERR_API_KEY=
# Flux RSS et groupes configurés dans Settings → Flux RSS (fichier experience.json).
# Ne pas mettre les clés API / mots de passe Pi-hole dans cet exemple.
